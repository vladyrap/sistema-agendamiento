# Variables para el stack STAGING.
# Usado por docker-compose.staging.yml — paralelo a prod en el mismo VPS.

# ── Dominio y URL pública ──────────────────────────────────────────────────
STAGING_DOMAIN=staging.miespejo.cl
STAGING_DOMAIN_HOST=staging.miespejo.cl
STAGING_APP_PUBLIC_URL=https://staging.miespejo.cl

# ── Postgres staging (distinto al de prod) ─────────────────────────────────
# El deploy_staging.sh auto-genera POSTGRES_PASSWORD si está vacía.
POSTGRES_USER=staging
POSTGRES_DB=staging
POSTGRES_PASSWORD=

# ── App secret (distinto al de prod — datos clínicos encriptados con HKDF
# derivado de SECRET_KEY, así que NUNCA uses la misma key) ──────────────────
SECRET_KEY=

# ── MercadoPago (SIEMPRE sandbox en staging) ───────────────────────────────
# Sacá tus credenciales TEST de https://www.mercadopago.cl/developers
STAGING_MP_ACCESS_TOKEN=
STAGING_MP_PUBLIC_KEY=
STAGING_MP_WEBHOOK_SECRET=

# ── Twilio (vacío = no manda nada real, solo logs) ─────────────────────────
STAGING_TWILIO_ACCOUNT_SID=
STAGING_TWILIO_AUTH_TOKEN=
STAGING_TWILIO_FROM_NUMBER=

# ── SMTP staging — opcional. Si vacío usa el SMTP de prod pero con
# STAGING_SMTP_FROM distinto para no confundir bandejas. ───────────────────
STAGING_SMTP_FROM=noreply-staging@staging.miespejo.cl
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ── Gemini — staging puede usar la misma key o una key separada con quota
# baja. Vacío hereda de la principal (cuidado: cuota compartida con prod). ──
STAGING_GEMINI_API_KEY=

APP_TIMEZONE=America/Santiago
MP_CURRENCY=CLP
