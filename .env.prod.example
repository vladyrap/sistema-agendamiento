# ─── Producción ─────────────────────────────────────────────────────────
# 1) Edita DOMAIN: pon tu hostname real para HTTPS automático,
#    o ":80" para servir HTTP plano sobre la IP del VPS.
# 2) ACME_EMAIL es para Let's Encrypt cuando uses dominio real.
# 3) deploy.sh genera SECRET_KEY y POSTGRES_PASSWORD si no están seteados.

DOMAIN=:80
DOMAIN_HOST=82.223.196.65
ACME_EMAIL=tu-correo@ejemplo.com
APP_PUBLIC_URL=http://82.223.196.65

# Generados por deploy.sh si no existen — NO subir a git
SECRET_KEY=
POSTGRES_PASSWORD=
GRAFANA_PASSWORD=

POSTGRES_USER=agendamiento
POSTGRES_DB=agendamiento

# SMTP (vacío = log-only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Logstash — set empty to skip TCP forwarding (logs still go to stdout).
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5000

# MercadoPago — vacío = pagos deshabilitados (las citas no piden pago).
# Genera credenciales en https://www.mercadopago.cl/developers/panel
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_CURRENCY=CLP

# Twilio — vacío = log-only. Crea cuenta en https://www.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

GRAFANA_USER=admin

# ── Backups ─────────────────────────────────────────────────────────────
# La passphrase la auto-genera deploy.sh la primera vez. NO LA CAMBIES después,
# o no podrás desencriptar los backups antiguos.
BACKUP_PASSPHRASE=
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
LOCAL_RETENTION_DAYS=7

# Backblaze B2 — vacío = backup local solamente.
# Crea cuenta en backblaze.com, un bucket privado, y un Application Key
# con permisos solo a ese bucket.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
