SECRET_KEY=change-me-in-production

# SMTP — leave SMTP_HOST empty to log notifications instead of sending email.
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@agendamiento.local
SMTP_USE_TLS=false

# Logstash — set empty to skip TCP forwarding (logs still go to stdout).
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5000
