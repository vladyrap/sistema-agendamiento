  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "title": "HTTP request rate (per endpoint)",
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total[1m]))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "title": "Request latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "title": "Citas creadas (rate / min)",
      "targets": [
        {
          "expr": "sum by (specialty) (rate(appointments_created_total[5m])) * 60",
          "legendFormat": "{{specialty}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "title": "Citas canceladas por actor",
      "targets": [
        {
          "expr": "sum by (actor) (rate(appointments_cancelled_total[5m])) * 60",
          "legendFormat": "{{actor}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 5,
      "title": "Notificaciones procesadas",
      "targets": [
        {
          "expr": "sum by (type, outcome) (rate(notifications_processed_total[5m])) * 60",
          "legendFormat": "{{type}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 6,
      "title": "Slot lookup latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(slot_lookup_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 7,
      "title": "Total citas (acumulado)",
      "targets": [
        {
          "expr": "sum(appointments_created_total)",
          "legendFormat": "creadas",
          "refId": "A"
        },
        {
          "expr": "sum(appointments_cancelled_total)",
          "legendFormat": "canceladas",
          "refId": "B"
        },
        {
          "expr": "sum(appointments_completed_total)",
          "legendFormat": "completadas",
          "refId": "C"
        }
      ],
      "type": "timeseries"
    }
